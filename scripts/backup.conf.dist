# Copier ce fichier en backup.conf et renseigner les valeurs réelles
# Ce fichier est commité — backup.conf est gitignored

PROD_SSH_USER=
PROD_SSH_HOST=
PROD_SSH_PORT=22
PROD_BACKUP_REMOTE_DIR=
PROD_BACKUP_PREFIX=day-vgr
# Répertoire local des backups (ex: destination du pull nocturne via cron+rsync).
# Les fichiers y sont attendus en .sql.gpg (chiffrés GPG), .sql.gz ou .sql.
PROD_BACKUP_LOCAL_DIR=$HOME/backups-vps/vgr

# Base de données locale (cible de l'import)
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=3306
LOCAL_DB_USER=
LOCAL_DB_PASSWORD=
LOCAL_DB_NAME=
