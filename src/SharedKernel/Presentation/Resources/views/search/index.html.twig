{% extends '@SharedKernel/base.html.twig' %}

{% trans_default_domain 'SharedKernel' %}

{% block title %}{{ 'search.title'|trans }} - Video Games Records{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-lg-10"
                data-controller="search-page"
                data-search-page-games-url-value="{{ path('vgr_api_game_autocomplete') }}"
                data-search-page-players-url-value="{{ path('vgr_api_player_autocomplete') }}"
                data-search-page-teams-url-value="{{ path('vgr_api_team_autocomplete') }}"
                data-search-page-locale-value="{{ app.request.locale }}"
                data-search-page-game-label-value="{{ 'search.games'|trans }}"
                data-search-page-player-label-value="{{ 'search.players'|trans }}"
                data-search-page-team-label-value="{{ 'search.teams'|trans }}"
                data-search-page-no-results-label-value="{{ 'search.no_results'|trans }}"
                data-search-page-min-chars-label-value="{{ 'search.min_chars'|trans }}"
                data-search-page-initial-query-value="{{ q }}"
            >
                <h1 class="mb-4 text-center">{{ 'search.title'|trans }}</h1>

                <div class="input-group input-group-lg mb-4">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input
                        type="text"
                        class="form-control"
                        placeholder="{{ 'search.placeholder'|trans }}"
                        data-search-page-target="input"
                        data-action="input->search-page#onInput"
                        value="{{ q }}"
                        autofocus
                    >
                </div>

                <div data-search-page-target="results">
                    <p class="text-muted text-center mt-4">{{ 'search.min_chars'|trans }}</p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
