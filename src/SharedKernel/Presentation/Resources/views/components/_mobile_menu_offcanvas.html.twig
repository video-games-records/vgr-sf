{% trans_default_domain 'SharedKernel' %}
<div class="offcanvas offcanvas-end d-lg-none" tabindex="-1" id="mobileMenuOffcanvas" aria-labelledby="mobileMenuLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="mobileMenuLabel">
            <i class="bi bi-list me-2"></i>Menu
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="{{ 'common.close'|trans }}"></button>
    </div>
    <div class="offcanvas-body p-0">

        {# Accordion sections #}
        <div class="accordion accordion-flush" id="mobileMenuAccordion">

            {# Games #}
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#mobileGames" aria-expanded="false" aria-controls="mobileGames">
                        <i class="bi bi-controller me-2"></i>{{ 'navigation.games'|trans }}
                    </button>
                </h2>
                <div id="mobileGames" class="accordion-collapse collapse" data-bs-parent="#mobileMenuAccordion">
                    <div class="list-group list-group-flush">
                        <a href="{{ path('vgr_game_list_by_letter', {letter: 'a'}) }}" class="list-group-item list-group-item-action ps-4"><i class="bi bi-alphabet me-2"></i>{{ 'navigation.games_dropdown.by_letter'|trans }}</a>
                        <a href="{{ path('vgr_platform_index') }}" class="list-group-item list-group-item-action ps-4"><i class="bi bi-controller me-2"></i>{{ 'navigation.games_dropdown.by_platform'|trans }}</a>
                        <a href="{{ path('vgr_serie_index') }}" class="list-group-item list-group-item-action ps-4"><i class="bi bi-collection me-2"></i>{{ 'navigation.games_dropdown.by_series'|trans }}</a>
                        <a href="{{ path('vgr_core_game_download_list') }}" class="list-group-item list-group-item-action ps-4"><i class="bi bi-download me-2"></i>{{ 'navigation.games_dropdown.downloads'|trans }}</a>
                        <a href="{{ path('vgr_game_list_featured') }}" class="list-group-item list-group-item-action ps-4"><i class="bi bi-star me-2"></i>{{ 'navigation.games_dropdown.featured_games'|trans }}</a>
                        <a href="{{ path('vgr_game_list_latest') }}" class="list-group-item list-group-item-action ps-4"><i class="bi bi-clock-history me-2"></i>{{ 'navigation.games_dropdown.latest_games'|trans }}</a>
                    </div>
                </div>
            </div>

            {# Leaderboards #}
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#mobileLeaderboards" aria-expanded="false" aria-controls="mobileLeaderboards">
                        <i class="bi bi-trophy me-2"></i>{{ 'navigation.leaderboards'|trans }}
                    </button>
                </h2>
                <div id="mobileLeaderboards" class="accordion-collapse collapse" data-bs-parent="#mobileMenuAccordion">
                    <div class="list-group list-group-flush">
                        <a href="{{ path('leaderboard_point_games') }}" class="list-group-item list-group-item-action ps-4"><i class="bi bi-graph-up-arrow me-2"></i>{{ 'navigation.leaderboards_dropdown.game_points'|trans }}</a>
                        <a href="{{ path('leaderboard_point_charts') }}" class="list-group-item list-group-item-action ps-4"><i class="bi bi-bar-chart-line me-2"></i>{{ 'navigation.leaderboards_dropdown.record_points'|trans }}</a>
                        <a href="{{ path('leaderboard_medals') }}" class="list-group-item list-group-item-action ps-4"><i class="bi bi-award me-2"></i>{{ 'navigation.leaderboards_dropdown.medals'|trans }}</a>
                        <a href="{{ path('leaderboard_cups') }}" class="list-group-item list-group-item-action ps-4"><i class="bi bi-trophy me-2"></i>{{ 'navigation.leaderboards_dropdown.cups'|trans }}</a>
                        <a href="{{ path('leaderboard_badges') }}" class="list-group-item list-group-item-action ps-4"><i class="bi bi-patch-check me-2"></i>{{ 'navigation.leaderboards_dropdown.badges'|trans }}</a>
                        <a href="{{ path('leaderboard_proofs') }}" class="list-group-item list-group-item-action ps-4"><i class="bi bi-camera-video me-2"></i>{{ 'navigation.leaderboards_dropdown.proofs'|trans }}</a>
                        <a href="{{ path('vgr_score_search') }}" class="list-group-item list-group-item-action ps-4"><i class="bi bi-search me-2"></i>{{ 'navigation.leaderboards_dropdown.score_search'|trans }}</a>
                        <a href="{{ path('vgr_country_show', {id: 1, slug: 'france'}) }}" class="list-group-item list-group-item-action ps-4"><i class="bi bi-flag me-2"></i>{{ 'navigation.leaderboards_dropdown.country'|trans }}</a>
                        <a href="{{ path('vgr_top_ranking') }}" class="list-group-item list-group-item-action ps-4"><i class="bi bi-star me-2"></i>{{ 'navigation.leaderboards_dropdown.top_ranking'|trans }}</a>
                    </div>
                </div>
            </div>

            {# Community #}
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#mobileCommunity" aria-expanded="false" aria-controls="mobileCommunity">
                        <i class="bi bi-people me-2"></i>{{ 'navigation.community'|trans }}
                    </button>
                </h2>
                <div id="mobileCommunity" class="accordion-collapse collapse" data-bs-parent="#mobileMenuAccordion">
                    <div class="list-group list-group-flush">
                        <a href="{{ path('forum_index') }}" class="list-group-item list-group-item-action ps-4"><i class="bi bi-chat-dots me-2"></i>{{ 'navigation.community_dropdown.forum'|trans }}</a>
                        <a href="{{ path('vgr_player_index') }}" class="list-group-item list-group-item-action ps-4"><i class="bi bi-person me-2"></i>{{ 'navigation.community_dropdown.players'|trans }}</a>
                        <a href="{{ path('vgr_team_index') }}" class="list-group-item list-group-item-action ps-4"><i class="bi bi-people me-2"></i>{{ 'navigation.community_dropdown.teams'|trans }}</a>
                    </div>
                </div>
            </div>

        </div>

        {# Direct links #}
        <div class="list-group list-group-flush border-top">
            <a href="{{ path('vgr_video_list') }}" class="list-group-item list-group-item-action">
                <i class="bi bi-play-circle me-2"></i>{{ 'navigation.videos'|trans }}
            </a>
            <a href="{{ path('global_search') }}" class="list-group-item list-group-item-action">
                <i class="bi bi-search me-2"></i>{{ 'common.search'|trans }}
            </a>
        </div>

        {# Language switcher #}
        <div class="p-3 border-top">
            <p class="text-muted small mb-2 fw-semibold"><i class="bi bi-globe me-1"></i>Language</p>
            {% set current_route = app.request.attributes.get('_route') %}
            {% set route_params = app.request.attributes.get('_route_params')|default({}) %}
            <div class="d-flex flex-wrap gap-2">
                <a href="{{ current_route ? path(current_route, route_params|merge({'_locale': 'en'})) : path('home', {'_locale': 'en'}) }}" class="btn btn-sm {{ app.request.locale == 'en' ? 'btn-primary' : 'btn-outline-secondary' }}">🇬🇧 EN</a>
                <a href="{{ current_route ? path(current_route, route_params|merge({'_locale': 'fr'})) : path('home', {'_locale': 'fr'}) }}" class="btn btn-sm {{ app.request.locale == 'fr' ? 'btn-primary' : 'btn-outline-secondary' }}">🇫🇷 FR</a>
                <a href="{{ current_route ? path(current_route, route_params|merge({'_locale': 'de'})) : path('home', {'_locale': 'de'}) }}" class="btn btn-sm {{ app.request.locale == 'de' ? 'btn-primary' : 'btn-outline-secondary' }}">🇩🇪 DE</a>
                <a href="{{ current_route ? path(current_route, route_params|merge({'_locale': 'es'})) : path('home', {'_locale': 'es'}) }}" class="btn btn-sm {{ app.request.locale == 'es' ? 'btn-primary' : 'btn-outline-secondary' }}">🇪🇸 ES</a>
                <a href="{{ current_route ? path(current_route, route_params|merge({'_locale': 'it'})) : path('home', {'_locale': 'it'}) }}" class="btn btn-sm {{ app.request.locale == 'it' ? 'btn-primary' : 'btn-outline-secondary' }}">🇮🇹 IT</a>
                <a href="{{ current_route ? path(current_route, route_params|merge({'_locale': 'ja'})) : path('home', {'_locale': 'ja'}) }}" class="btn btn-sm {{ app.request.locale == 'ja' ? 'btn-primary' : 'btn-outline-secondary' }}">🇯🇵 JA</a>
                <a href="{{ current_route ? path(current_route, route_params|merge({'_locale': 'pt_BR'})) : path('home', {'_locale': 'pt_BR'}) }}" class="btn btn-sm {{ app.request.locale == 'pt_BR' ? 'btn-primary' : 'btn-outline-secondary' }}">🇧🇷 PT</a>
                <a href="{{ current_route ? path(current_route, route_params|merge({'_locale': 'zh_CN'})) : path('home', {'_locale': 'zh_CN'}) }}" class="btn btn-sm {{ app.request.locale == 'zh_CN' ? 'btn-primary' : 'btn-outline-secondary' }}">🇨🇳 ZH</a>
            </div>
        </div>

        {# Theme #}
        <div class="p-3 border-top d-flex gap-2">
            <button class="btn btn-outline-secondary btn-sm flex-grow-1" onclick="toggleTheme()">
                <i class="bi bi-moon-fill me-1"></i>{{ 'theme.toggle'|trans }}
            </button>
            <button class="btn btn-outline-secondary btn-sm" data-bs-toggle="offcanvas" data-bs-target="#themePicker" aria-label="Choisir un thème">
                <i class="bi bi-palette"></i>
            </button>
        </div>

        {# User section #}
        <div class="border-top">
            {% if app.user %}
                {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_SONATA_ADMIN') %}
                    <a href="{{ path('sonata_admin_dashboard') }}" class="list-group-item list-group-item-action" data-turbo-prefetch="false" target="_blank">
                        <i class="bi bi-speedometer2 me-2"></i>{{ 'navigation.admin'|trans }}
                    </a>
                {% endif %}
                <div class="list-group list-group-flush">
                    <a href="{{ path('vgr_player_profile_overview', {id: app.user.id, slug: app.user.slug}) }}" class="list-group-item list-group-item-action"><i class="bi bi-person me-2"></i>{{ 'navigation.user_menu.profile'|trans }}</a>
                    <a href="{{ path('app_profile_index') }}" class="list-group-item list-group-item-action"><i class="bi bi-gear me-2"></i>{{ 'navigation.user_menu.settings'|trans }}</a>
                    <a href="{{ path('vgr_team_manage') }}" class="list-group-item list-group-item-action"><i class="bi bi-people-fill me-2"></i>{{ 'navigation.user_menu.team'|trans }}</a>
                    <a href="{{ path('vgr_my_proofs') }}" class="list-group-item list-group-item-action"><i class="bi bi-camera me-2"></i>{{ 'navigation.user_menu.my_proofs'|trans }}</a>
                    <a href="{{ path('vgr_my_videos') }}" class="list-group-item list-group-item-action"><i class="bi bi-play-circle me-2"></i>{{ 'navigation.user_menu.my_videos'|trans }}</a>
                    <a href="{{ path('vgr_game_history') }}" class="list-group-item list-group-item-action"><i class="bi bi-clock-history me-2"></i>{{ 'navigation.user_menu.game_history'|trans }}</a>
                    <a href="{{ path('message_inbox') }}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-envelope me-2"></i>{{ 'navigation.user_menu.messages'|trans }}</span>
                        {% set unread_count = get_unread_messages_count() %}
                        {% if unread_count > 0 %}
                            <span class="badge bg-danger">{{ unread_count }}</span>
                        {% endif %}
                    </a>
                    <a href="{{ path('vgr_friends') }}" class="list-group-item list-group-item-action"><i class="bi bi-people me-2"></i>{{ 'navigation.user_menu.friends'|trans }}</a>
                    <a href="{{ path('vgr_lost_positions') }}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-graph-down-arrow me-2"></i>{{ 'navigation.user_menu.lost_positions'|trans }}</span>
                        {% set lost_count = get_new_lost_positions_count() %}
                        {% if lost_count > 0 %}
                            <span class="badge bg-danger">{{ lost_count }}</span>
                        {% endif %}
                    </a>
                    <a href="{{ path('app_logout') }}" class="list-group-item list-group-item-action text-danger"><i class="bi bi-box-arrow-right me-2"></i>{{ 'navigation.user_menu.logout'|trans }}</a>
                </div>
            {% else %}
                <div class="p-3">
                    <a href="{{ path('app_login') }}" class="btn btn-primary w-100" data-turbo="false" data-turbo-prefetch="false">
                        <i class="bi bi-box-arrow-in-right me-2"></i>{{ 'navigation.login'|trans }}
                    </a>
                </div>
            {% endif %}
        </div>

    </div>
</div>
