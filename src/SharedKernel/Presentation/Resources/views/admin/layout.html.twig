{# templates/admin/layout.html.twig #}
{% extends '@SonataAdmin/standard_layout.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('admin') }}
    <style>
        /* A2lix Translation Tabs Styling */
        .a2lix_translations {
            margin: 20px 0;
        }

        .a2lix_translationsLocales.nav-tabs {
            border-bottom: 2px solid #dee2e6;
            margin-bottom: 20px;
        }

        .a2lix_translationsLocales .nav-item {
            margin-bottom: -2px;
        }

        .a2lix_translationsLocales .nav-link {
            border: 1px solid transparent;
            border-radius: 0.375rem 0.375rem 0 0;
            padding: 0.75rem 1.25rem;
            color: #495057;
            background-color: transparent;
            transition: all 0.15s ease-in-out;
            cursor: pointer;
        }

        .a2lix_translationsLocales .nav-link:hover {
            border-color: #e9ecef #e9ecef #dee2e6;
            background-color: #f8f9fa;
            color: #0d6efd;
        }

        .a2lix_translationsLocales .nav-link.active {
            color: #0d6efd;
            background-color: #fff;
            border-color: #dee2e6 #dee2e6 #fff;
            border-bottom-width: 2px;
            font-weight: 600;
        }

        .a2lix_translationsFields.tab-content {
            padding: 20px;
            background-color: #fff;
            border: 1px solid #dee2e6;
            border-top: none;
            border-radius: 0 0 0.375rem 0.375rem;
        }

        .a2lix_translationsFields .tab-pane {
            animation: fadeIn 0.2s ease-in;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        
        /* Force dropdown menu items to display vertically one below another */
        .navbar-custom-menu .dropdown-menu {
            min-width: 150px;
        }
        
        .navbar-custom-menu .dropdown-menu a {
            display: block !important;
            width: 100% !important;
            padding: 8px 15px !important;
            clear: both !important;
            white-space: nowrap !important;
            text-align: left !important;
            line-height: 1.4 !important;
        }
        
        .navbar-custom-menu .dropdown-menu a:hover {
            background-color: #f5f5f5 !important;
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('admin') }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            setTimeout(initTranslationTabs, 100);

            document.addEventListener('sonata-collection-item-added', function() {
                setTimeout(initTranslationTabs, 100);
            });
        });

        function initTranslationTabs() {
            document.querySelectorAll('[data-bs-toggle="tab"]').forEach(function(tabElement) {
                tabElement.style.cursor = 'pointer';
                tabElement.addEventListener('click', function(e) {
                    e.preventDefault();
                    activateTranslationTab(tabElement);
                });
            });
        }

        function activateTranslationTab(tabElement) {
            const targetPane = document.querySelector(tabElement.getAttribute('data-bs-target'));
            if (!targetPane) {
                return;
            }

            const navContainer = tabElement.closest('.nav');
            if (navContainer) {
                navContainer.querySelectorAll('.nav-link.active').forEach(function(el) {
                    el.classList.remove('active');
                });
            }
            tabElement.classList.add('active');

            const tabContent = targetPane.closest('.tab-content');
            if (tabContent) {
                tabContent.querySelectorAll('.tab-pane.active').forEach(function(el) {
                    el.classList.remove('show', 'active');
                });
            }
            targetPane.classList.add('show', 'active');
        }
    </script>
{% endblock %}

{% block sonata_top_nav_menu %}
    <div class="navbar-custom-menu">
        <ul class="nav navbar-nav">
            {# Language Switcher using the existing component style #}
            <li class="dropdown">
                <a class="dropdown-toggle" data-toggle="dropdown" href="#" style="color: #333; padding: 10px 15px;">
                    {% if app.request.locale == 'fr' %}
                        🇫🇷 Français
                    {% elseif app.request.locale == 'de' %}
                        🇩🇪 Deutsch
                    {% elseif app.request.locale == 'it' %}
                        🇮🇹 Italiano
                    {% elseif app.request.locale == 'ja' %}
                        🇯🇵 日本語
                    {% elseif app.request.locale == 'es' %}
                        🇪🇸 Español
                    {% elseif app.request.locale == 'pt_BR' %}
                        🇧🇷 Português
                    {% elseif app.request.locale == 'zh_CN' %}
                        🇨🇳 中文
                    {% else %}
                        🇬🇧 English
                    {% endif %}
                    <i class="fas fa-caret-down" aria-hidden="true"></i>
                </a>
                <div class="dropdown-menu">
                    <a class="dropdown-item {{ app.request.locale == 'en' ? 'active' : '' }}" 
                       href="{{ path('admin_locale_switch', {locale: 'en'}) }}">
                        🇬🇧 English
                    </a>
                    <a class="dropdown-item {{ app.request.locale == 'fr' ? 'active' : '' }}" 
                       href="{{ path('admin_locale_switch', {locale: 'fr'}) }}">
                        🇫🇷 Français
                    </a>
                    <a class="dropdown-item {{ app.request.locale == 'de' ? 'active' : '' }}" 
                       href="{{ path('admin_locale_switch', {locale: 'de'}) }}">
                        🇩🇪 Deutsch
                    </a>
                    <a class="dropdown-item {{ app.request.locale == 'it' ? 'active' : '' }}" 
                       href="{{ path('admin_locale_switch', {locale: 'it'}) }}">
                        🇮🇹 Italiano
                    </a>
                    <a class="dropdown-item {{ app.request.locale == 'ja' ? 'active' : '' }}" 
                       href="{{ path('admin_locale_switch', {locale: 'ja'}) }}">
                        🇯🇵 日本語
                    </a>
                    <a class="dropdown-item {{ app.request.locale == 'es' ? 'active' : '' }}" 
                       href="{{ path('admin_locale_switch', {locale: 'es'}) }}">
                        🇪🇸 Español
                    </a>
                    <a class="dropdown-item {{ app.request.locale == 'pt_BR' ? 'active' : '' }}" 
                       href="{{ path('admin_locale_switch', {locale: 'pt_BR'}) }}">
                        🇧🇷 Português
                    </a>
                    <a class="dropdown-item {{ app.request.locale == 'zh_CN' ? 'active' : '' }}" 
                       href="{{ path('admin_locale_switch', {locale: 'zh_CN'}) }}">
                        🇨🇳 中文
                    </a>
                </div>
            </li>
            
            {# Original Sonata Blocks #}
            {% block sonata_top_nav_menu_add_block %}
                {% set addBlock = include(get_global_template('add_block')) %}
                {% if addBlock|trim is not empty %}
                    <li class="dropdown">
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fas fa-plus-square fa-fw" aria-hidden="true"></i> <i class="fas fa-caret-down" aria-hidden="true"></i>
                        </a>
                        {{ addBlock|raw }}
                    </li>
                {% endif %}
            {% endblock %}
            {% if app.user %}
                {% block sonata_top_nav_menu_user_block %}
                    {% set userBlock = include(get_global_template('user_block')) %}
                    {% if userBlock|trim is not empty %}
                        <li class="dropdown user-menu">
                            <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                                <i class="fas fa-user fa-fw" aria-hidden="true"></i> <i class="fas fa-caret-down" aria-hidden="true"></i>
                            </a>
                            {{ userBlock|raw }}
                        </li>
                    {% endif %}
                {% endblock %}
            {% endif %}
        </ul>
    </div>
{% endblock %}
