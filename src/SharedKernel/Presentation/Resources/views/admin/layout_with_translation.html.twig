{# templates/admin/layout_with_translation.html.twig #}
{% extends '@SonataTranslation/standard_layout.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('admin') }}
    <style>
        /* A2lix Translation Tabs Styling */
        .a2lix_translations {
            margin: 20px 0;
        }

        .a2lix_translationsLocales.nav-tabs {
            border-bottom: 2px solid #dee2e6;
            margin-bottom: 20px;
        }

        .a2lix_translationsLocales .nav-item {
            margin-bottom: -2px;
        }

        .a2lix_translationsLocales .nav-link {
            border: 1px solid transparent;
            border-radius: 0.375rem 0.375rem 0 0;
            padding: 0.75rem 1.25rem;
            color: #495057;
            background-color: transparent;
            transition: all 0.15s ease-in-out;
            cursor: pointer;
        }

        .a2lix_translationsLocales .nav-link:hover {
            border-color: #e9ecef #e9ecef #dee2e6;
            background-color: #f8f9fa;
            color: #0d6efd;
        }

        .a2lix_translationsLocales .nav-link.active {
            color: #0d6efd;
            background-color: #fff;
            border-color: #dee2e6 #dee2e6 #fff;
            border-bottom-width: 2px;
            font-weight: 600;
        }

        .a2lix_translationsFields.tab-content {
            padding: 20px;
            background-color: #fff;
            border: 1px solid #dee2e6;
            border-top: none;
            border-radius: 0 0 0.375rem 0.375rem;
        }

        .a2lix_translationsFields .tab-pane {
            animation: fadeIn 0.2s ease-in;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        
        /* Force language switcher visibility */
        .navbar-custom-menu .dropdown > a {
            color: #333 !important;
            padding: 10px 15px !important;
            background-color: #f4f4f4 !important;
            border: 1px solid #ddd !important;
            margin: 5px !important;
        }
        
        .navbar-custom-menu .dropdown > a:hover {
            background-color: #e7e7e7 !important;
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    {{ encore_entry_script_tags('admin') }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            setTimeout(initTranslationTabs, 100);

            document.addEventListener('sonata-collection-item-added', function() {
                setTimeout(initTranslationTabs, 100);
            });
        });

        function initTranslationTabs() {
            document.querySelectorAll('[data-bs-toggle="tab"]').forEach(function(tabElement) {
                tabElement.style.cursor = 'pointer';
                tabElement.addEventListener('click', function(e) {
                    e.preventDefault();
                    const tab = new bootstrap.Tab(tabElement);
                    tab.show();
                });
            });
        }
    </script>
{% endblock %}

{% block sonata_top_nav_menu %}
    <div class="navbar-custom-menu">
        <ul class="nav navbar-nav">
            {# Language Switcher #}
            {% set current_locale = app.request.locale %}
            {% set locales = {
                'en': 'English',
                'fr': 'Français',
                'de': 'Deutsch',
                'it': 'Italiano',
                'ja': '日本語',
                'es': 'Español',
                'pt_BR': 'Português',
                'zh_CN': '中文'
            } %}
            
            <li class="dropdown">
                <a class="dropdown-toggle" data-toggle="dropdown" href="#" role="button" aria-expanded="false">
                    <i class="fas fa-flag fa-fw" aria-hidden="true"></i>
                    <span class="d-none d-sm-inline">{{ locales[current_locale] ?? current_locale }}</span>
                    <i class="fas fa-caret-down" aria-hidden="true"></i>
                </a>
                <div class="dropdown-menu">
                    <div class="dropdown-header">
                        <i class="fas fa-language"></i> Languages
                    </div>
                    <div class="dropdown-divider"></div>
                    {% for locale_code, locale_name in locales %}
                        <a class="dropdown-item {% if locale_code == current_locale %}active{% endif %}" 
                           href="{{ path('admin_locale_switch', {locale: locale_code}) }}">
                            {{ locale_name }}
                        </a>
                    {% endfor %}
                </div>
            </li>
            
            {# Add Block #}
            {% block sonata_top_nav_menu_add_block %}
                {% set addBlock = include(get_global_template('add_block')) %}
                {% if addBlock|trim is not empty %}
                    <li class="dropdown">
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fas fa-plus-square fa-fw" aria-hidden="true"></i> <i class="fas fa-caret-down" aria-hidden="true"></i>
                        </a>
                        {{ addBlock|raw }}
                    </li>
                {% endif %}
            {% endblock %}
            
            {# User Block #}
            {% if app.user %}
                {% block sonata_top_nav_menu_user_block %}
                    {% set userBlock = include(get_global_template('user_block')) %}
                    {% if userBlock|trim is not empty %}
                        <li class="dropdown user-menu">
                            <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                                <i class="fas fa-user fa-fw" aria-hidden="true"></i> <i class="fas fa-caret-down" aria-hidden="true"></i>
                            </a>
                            {{ userBlock|raw }}
                        </li>
                    {% endif %}
                {% endblock %}
            {% endif %}
        </ul>
    </div>
{% endblock %}