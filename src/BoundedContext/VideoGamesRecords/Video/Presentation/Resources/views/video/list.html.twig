{% extends '@SharedKernel/base.html.twig' %}

{% block title %}Gaming Videos & Records - Video Games Records{% endblock %}

{% block meta_description %}
    Discover the latest gaming videos, world record runs, gameplay highlights and proof submissions from the Video Games Records community. {{ total_videos }} videos featuring the best players and records across all platforms.
{% endblock %}

{% block meta_keywords %}gaming videos, world records, speedrun, gameplay, video game records, gaming community, leaderboards, high scores, proof videos{% endblock %}

{% block og_title %}Gaming Videos & Records - Video Games Records{% endblock %}
{% block og_description %}Watch {{ total_videos }} gaming videos from top players worldwide. Speedruns, world records, and gameplay highlights from the Video Games Records community.{% endblock %}
{% block og_image %}{{ absolute_url(asset('build/images/vgr-social-share.jpg')) }}{% endblock %}
{% block og_type %}website{% endblock %}

{% block hreflang %}
    <link rel="alternate" hreflang="en" href="{{ absolute_url(path('vgr_video_list', {'_locale': 'en'})) }}">
    <link rel="alternate" hreflang="fr" href="{{ absolute_url(path('vgr_video_list', {'_locale': 'fr'})) }}">
    <link rel="alternate" hreflang="de" href="{{ absolute_url(path('vgr_video_list', {'_locale': 'de'})) }}">
    <link rel="alternate" hreflang="es" href="{{ absolute_url(path('vgr_video_list', {'_locale': 'es'})) }}">
    <link rel="alternate" hreflang="it" href="{{ absolute_url(path('vgr_video_list', {'_locale': 'it'})) }}">
    <link rel="alternate" hreflang="ja" href="{{ absolute_url(path('vgr_video_list', {'_locale': 'ja'})) }}">
    <link rel="alternate" hreflang="pt-BR" href="{{ absolute_url(path('vgr_video_list', {'_locale': 'pt_BR'})) }}">
    <link rel="alternate" hreflang="zh-CN" href="{{ absolute_url(path('vgr_video_list', {'_locale': 'zh_CN'})) }}">
    <link rel="alternate" hreflang="x-default" href="{{ absolute_url(path('vgr_video_list', {'_locale': 'en'})) }}">
{% endblock %}

{% block canonical_url %}{{ absolute_url(path('vgr_video_list', {'_locale': app.request.locale})) }}{% endblock %}

{% block structured_data %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Gaming Videos & Records",
    "description": "Discover the latest gaming videos, world record runs, gameplay highlights and proof submissions from the Video Games Records community.",
    "url": "{{ absolute_url(path('vgr_video_list', {'_locale': 'en'})) }}",
    "mainEntity": {
        "@type": "VideoGallery",
        "name": "Gaming Videos Collection",
        "numberOfItems": {{ total_videos }},
        "about": {
            "@type": "Thing",
            "name": "Video Game Records"
        }
    },
    "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "name": "Home",
                "item": "{{ absolute_url(path('home')) }}"
            },
            {
                "@type": "ListItem",
                "position": 2,
                "name": "Videos",
                "item": "{{ absolute_url(path('vgr_video_list')) }}"
            }
        ]
    },
    "publisher": {
        "@type": "Organization",
        "name": "Video Games Records",
        "url": "{{ absolute_url(path('home')) }}"
    }
}
</script>
{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="row">
            <div class="col-12">
                {% include '@VideoGamesRecordsVideo/shared/videos_grid.html.twig' with {
                    videos: videos,
                    total_videos: total_videos,
                    has_more: has_more,
                    api_url: api_url,
                    title: 'Videos'
                } %}
            </div>
        </div>
    </div>
{% endblock %}

