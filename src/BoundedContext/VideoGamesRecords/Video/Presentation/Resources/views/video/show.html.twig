{% extends '@SharedKernel/base.html.twig' %}
{% trans_default_domain 'VgrVideo' %}

{% block title %}{{ video.title }} - Video Games Records{% endblock %}

{% block meta_description %}
    {%- if video.description -%}
        {{- video.description|slice(0, 155) ~ (video.description|length > 155 ? '...' : '') -}}
    {%- else -%}
        Watch {{ video.title }}{% if video.game %} for {{ video.game.getName(app.request.locale) }}{% endif %}{% if video.player %} by {{ video.player.pseudo }}{% endif %}. Gaming video with {{ video.viewCount }} views on Video Games Records.
    {%- endif -%}
{% endblock %}

{% block meta_keywords %}{{ video.title }}{% if video.game %}, {{ video.game.getName(app.request.locale) }}{% endif %}{% if video.player %}, {{ video.player.pseudo }}{% endif %}, gaming video, {% if video.type == 'Youtube' %}youtube{% else %}{{ video.type|lower }}{% endif %}, video games records, gameplay{% endblock %}

{% block og_title %}{{ video.title }}{% endblock %}
{% block og_description %}
    {%- if video.description -%}
        {{- video.description|slice(0, 200) ~ (video.description|length > 200 ? '...' : '') -}}
    {%- else -%}
        Watch {{ video.title }}{% if video.game %} for {{ video.game.getName(app.request.locale) }}{% endif %}{% if video.player %} by {{ video.player.pseudo }}{% endif %} on Video Games Records.
    {%- endif -%}
{% endblock %}
{% block og_image %}{% if video.thumbnail %}{{ video.thumbnail }}{% else %}{{ absolute_url(asset('build/images/vgr-social-share.jpg')) }}{% endif %}{% endblock %}
{% block og_type %}video.other{% endblock %}
{% block og_video %}{% if video.type == 'Youtube' %}<meta property="og:video" content="https://www.youtube.com/watch?v={{ video.externalId }}">{% elseif video.type == 'Twitch' %}<meta property="og:video" content="https://www.twitch.tv/videos/{{ video.externalId }}">{% endif %}{% endblock %}

{% block hreflang %}
    <link rel="alternate" hreflang="en" href="{{ absolute_url(path('vgr_video_show', {'_locale': 'en', 'id': video.id, 'slug': video.slug})) }}">
    <link rel="alternate" hreflang="fr" href="{{ absolute_url(path('vgr_video_show', {'_locale': 'fr', 'id': video.id, 'slug': video.slug})) }}">
    <link rel="alternate" hreflang="de" href="{{ absolute_url(path('vgr_video_show', {'_locale': 'de', 'id': video.id, 'slug': video.slug})) }}">
    <link rel="alternate" hreflang="es" href="{{ absolute_url(path('vgr_video_show', {'_locale': 'es', 'id': video.id, 'slug': video.slug})) }}">
    <link rel="alternate" hreflang="it" href="{{ absolute_url(path('vgr_video_show', {'_locale': 'it', 'id': video.id, 'slug': video.slug})) }}">
    <link rel="alternate" hreflang="ja" href="{{ absolute_url(path('vgr_video_show', {'_locale': 'ja', 'id': video.id, 'slug': video.slug})) }}">
    <link rel="alternate" hreflang="pt-BR" href="{{ absolute_url(path('vgr_video_show', {'_locale': 'pt_BR', 'id': video.id, 'slug': video.slug})) }}">
    <link rel="alternate" hreflang="zh-CN" href="{{ absolute_url(path('vgr_video_show', {'_locale': 'zh_CN', 'id': video.id, 'slug': video.slug})) }}">
    <link rel="alternate" hreflang="x-default" href="{{ absolute_url(path('vgr_video_show', {'_locale': 'en', 'id': video.id, 'slug': video.slug})) }}">
{% endblock %}

{% block canonical_url %}{{ absolute_url(path('vgr_video_show', {'_locale': app.request.locale, 'id': video.id, 'slug': video.slug})) }}{% endblock %}

{% block structured_data %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "VideoObject",
    "name": "{{ video.title|e('js') }}",
    "description": "{% if video.description %}{{ video.description|slice(0, 500)|e('js') }}{% else %}Gaming video{% if video.game %} for {{ video.game.getName(app.request.locale)|e('js') }}{% endif %}{% if video.player %} by {{ video.player.pseudo|e('js') }}{% endif %} on Video Games Records{% endif %}",
    "thumbnailUrl": "{% if video.thumbnail %}{{ video.thumbnail }}{% else %}{{ absolute_url(asset('build/images/vgr-social-share.jpg')) }}{% endif %}",
    "uploadDate": "{{ video.createdAt|date('c') }}",
    "contentUrl": "{% if video.type == 'Youtube' %}https://www.youtube.com/watch?v={{ video.externalId }}{% elseif video.type == 'Twitch' %}https://www.twitch.tv/videos/{{ video.externalId }}{% else %}{{ video.url }}{% endif %}",
    "embedUrl": "{% if video.type == 'Youtube' %}https://www.youtube.com/embed/{{ video.externalId }}{% elseif video.type == 'Twitch' %}https://player.twitch.tv/?video={{ video.externalId }}{% endif %}",
    "interactionStatistic": [
        {
            "@type": "InteractionCounter",
            "interactionType": "https://schema.org/WatchAction",
            "userInteractionCount": "{{ video.viewCount }}"
        }
        {% if video.likeCount > 0 %},
        {
            "@type": "InteractionCounter",
            "interactionType": "https://schema.org/LikeAction",
            "userInteractionCount": "{{ video.likeCount }}"
        }
        {% endif %}
    ],
    "author": {
        "@type": "Person",
        "name": "{% if video.player %}{{ video.player.pseudo|e('js') }}{% else %}Anonymous{% endif %}",
        "url": "{% if video.player %}{{ absolute_url(path('vgr_player_profile_overview', {id: video.player.id, slug: video.player.slug})) }}{% endif %}"
    },
    "publisher": {
        "@type": "Organization",
        "name": "Video Games Records",
        "url": "{{ absolute_url(path('home')) }}"
    }
    {% if video.game %},
    "about": {
        "@type": "VideoGame",
        "name": "{{ video.game.getName(app.request.locale)|e('js') }}",
        "url": "{{ absolute_url(path('vgr_game_show', {id: video.game.id, slug: video.game.slug})) }}"
    }
    {% endif %}
}
</script>
{% endblock %}

{% block body %}
    <div class="container-fluid py-4">
        {# Breadcrumb Navigation #}
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('home') }}">Home</a></li>
                <li class="breadcrumb-item"><a href="{{ path('vgr_video_list') }}">Videos</a></li>
                {% if video.game %}
                    <li class="breadcrumb-item"><a href="{{ path('vgr_game_videos', {id: video.game.id, slug: video.game.slug}) }}">{{ video.game.getName(app.request.locale) }}</a></li>
                {% endif %}
                <li class="breadcrumb-item active" aria-current="page">{{ video.title|slice(0, 50) }}{% if video.title|length > 50 %}...{% endif %}</li>
            </ol>
        </nav>

        <div class="row">
            {# Contenu principal - Vidéo #}
            <div class="col-12 col-lg-8">
                <article itemscope itemtype="https://schema.org/VideoObject">
                    <div class="video-player-container mb-4">
                    {% if video.type == 'Youtube' %}
                        {# Lecteur YouTube intégré #}
                        <div class="ratio ratio-16x9">
                            <iframe src="https://www.youtube.com/embed/{{ video.externalId }}?rel=0" 
                                    title="{{ video.title }}" 
                                    allowfullscreen>
                            </iframe>
                        </div>
                    {% elseif video.type == 'Twitch' %}
                        {# Lecteur Twitch intégré #}
                        <div class="ratio ratio-16x9">
                            <iframe src="https://player.twitch.tv/?video={{ video.externalId }}&parent={{ app.request.host }}" 
                                    title="{{ video.title }}" 
                                    allowfullscreen>
                            </iframe>
                        </div>
                    {% else %}
                        {# Fallback pour autres types #}
                        <div class="ratio ratio-16x9 bg-light d-flex align-items-center justify-content-center">
                            <a href="{{ video.url }}" target="_blank" class="btn btn-primary btn-lg">
                                <i class="bi bi-play-circle me-2"></i>Watch Video
                            </a>
                        </div>
                    {% endif %}
                </div>

                {# Informations vidéo #}
                <div class="video-info mb-4">
                    <h1 class="h3 mb-3" itemprop="name">{{ video.title }}</h1>
                    
                    <div class="video-stats mb-3">
                        <span class="text-muted me-3">
                            <i class="bi bi-eye me-1"></i>{{ video.viewCount }} views
                        </span>
                        <span class="text-muted me-3">
                            <i class="bi bi-calendar me-1"></i>{{ video.createdAt|date('F j, Y') }}
                        </span>
                        {% if video.likeCount > 0 %}
                            <span class="text-muted">
                                <i class="bi bi-heart me-1"></i>{{ video.likeCount }} likes
                            </span>
                        {% endif %}
                    </div>

                    {# Créateur et jeu #}
                    <div class="d-flex align-items-center mb-3">
                        {% if video.player %}
                            <div class="me-4">
                                <strong>By:</strong> 
                                <a href="{{ path('vgr_player_profile_overview', {id: video.player.id, slug: video.player.slug}) }}" 
                                   class="text-decoration-none">
                                    {{ video.player.pseudo }}
                                </a>
                            </div>
                        {% endif %}
                        
                        {% if video.game %}
                            <div>
                                <strong>Game:</strong> 
                                <a href="{{ path('vgr_game_show', {id: video.game.id, slug: video.game.slug}) }}" 
                                   class="text-decoration-none">
                                    {{ video.game.getName(app.request.locale) }}
                                </a>
                            </div>
                        {% endif %}
                    </div>

                    {# Description #}
                    {% if video.description %}
                        <div class="video-description">
                            <h5>Description</h5>
                            <div class="border rounded p-3 bg-light" itemprop="description">
                                {{ video.description|nl2br }}
                            </div>
                        </div>
                    {% endif %}
                </div>

                {# Métadonnées cachées pour le SEO #}
                <meta itemprop="uploadDate" content="{{ video.createdAt|date('c') }}">
                <meta itemprop="thumbnailUrl" content="{% if video.thumbnail %}{{ video.thumbnail }}{% endif %}">
                </article>

                {# Section commentaires #}
                <div class="comments-section">
                    <h5 class="mb-3">Comments ({{ video.nbComment }})</h5>
                    
                    {# Flash messages #}
                    {% for flash_error in app.session.flashbag.get('danger') %}
                        <div class="alert alert-danger">{{ flash_error }}</div>
                    {% endfor %}
                    {% for flash_message in app.session.flashbag.get('success') %}
                        <div class="alert alert-success">{{ flash_message }}</div>
                    {% endfor %}
                    
                    {# Formulaire d'ajout de commentaire #}
                    {% if commentForm %}
                        <div class="add-comment mb-4">
                            <div class="card">
                                <div class="card-body">
                                    {{ form_start(commentForm) }}
                                        <div class="mb-3">
                                            {{ form_widget(commentForm.content) }}
                                            {{ form_errors(commentForm.content) }}
                                        </div>
                                        <button type="submit" class="btn btn-primary">
                                            <i class="bi bi-send me-1"></i>Post Comment
                                        </button>
                                    {{ form_end(commentForm) }}
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            <a href="{{ path('app_login') }}">Login</a> to add a comment.
                        </div>
                    {% endif %}

                    {# Liste des commentaires #}
                    {% if comments|length > 0 %}
                        {% for comment in comments %}
                            <div class="comment mb-3" id="comment-{{ comment.id }}">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div class="d-flex align-items-center">
                                                <strong class="me-2">
                                                    {% if comment.player %}
                                                        <a href="{{ path('vgr_player_profile_overview', {id: comment.player.id, slug: comment.player.slug}) }}" 
                                                           class="text-decoration-none">
                                                            {{ comment.player.pseudo }}
                                                        </a>
                                                    {% else %}
                                                        Anonymous
                                                    {% endif %}
                                                </strong>
                                                <small class="text-muted">{{ comment.createdAt|date('M j, Y H:i') }}</small>
                                            </div>
                                            {% if editForms[comment.id] is defined %}
                                                <button class="btn btn-outline-secondary btn-sm" 
                                                        onclick="toggleEditForm({{ comment.id }})"
                                                        type="button">
                                                    <i class="bi bi-pencil"></i> Edit
                                                </button>
                                            {% endif %}
                                        </div>
                                        
                                        {# Comment content #}
                                        <div class="comment-content-{{ comment.id }}">
                                            <p class="mb-0">{{ comment.content|nl2br }}</p>
                                        </div>
                                        
                                        {# Edit form (hidden by default) #}
                                        {% if editForms[comment.id] is defined %}
                                            <div class="edit-form-{{ comment.id }} d-none">
                                                {{ form_start(editForms[comment.id]) }}
                                                    <div class="mb-3">
                                                        {{ form_widget(editForms[comment.id].content, {
                                                            'value': comment.content,
                                                            'attr': {'rows': 3}
                                                        }) }}
                                                        {{ form_errors(editForms[comment.id].content) }}
                                                    </div>
                                                    <div class="d-flex gap-2">
                                                        <button type="submit" class="btn btn-success btn-sm">
                                                            <i class="bi bi-check2"></i> Save
                                                        </button>
                                                        <button type="button" class="btn btn-secondary btn-sm" 
                                                                onclick="toggleEditForm({{ comment.id }})">
                                                            <i class="bi bi-x"></i> Cancel
                                                        </button>
                                                    </div>
                                                {{ form_end(editForms[comment.id]) }}
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                        
                        {# Pagination #}
                        {% if totalPages > 1 %}
                            <nav aria-label="Comments pagination" class="mt-4">
                                <ul class="pagination justify-content-center">
                                    {% if currentPage > 1 %}
                                        <li class="page-item">
                                            <a class="page-link" href="{{ path('vgr_video_show', {id: video.id, slug: video.slug, page: currentPage - 1}) }}">
                                                <i class="bi bi-chevron-left"></i> Previous
                                            </a>
                                        </li>
                                    {% endif %}
                                    
                                    {% for page in 1..totalPages %}
                                        {% if page == currentPage %}
                                            <li class="page-item active">
                                                <span class="page-link">{{ page }}</span>
                                            </li>
                                        {% elseif page == 1 or page == totalPages or (page >= currentPage - 2 and page <= currentPage + 2) %}
                                            <li class="page-item">
                                                <a class="page-link" href="{{ path('vgr_video_show', {id: video.id, slug: video.slug, page: page}) }}">{{ page }}</a>
                                            </li>
                                        {% elseif page == 2 or page == totalPages - 1 %}
                                            <li class="page-item disabled">
                                                <span class="page-link">...</span>
                                            </li>
                                        {% endif %}
                                    {% endfor %}
                                    
                                    {% if currentPage < totalPages %}
                                        <li class="page-item">
                                            <a class="page-link" href="{{ path('vgr_video_show', {id: video.id, slug: video.slug, page: currentPage + 1}) }}">
                                                Next <i class="bi bi-chevron-right"></i>
                                            </a>
                                        </li>
                                    {% endif %}
                                </ul>
                            </nav>
                        {% endif %}
                    {% else %}
                        <div class="text-center py-4">
                            <i class="bi bi-chat-quote text-muted fs-1"></i>
                            <p class="text-muted mt-3 mb-0">{{ 'comment.messages.no_comments'|trans }}</p>
                        </div>
                    {% endif %}
                </div>
            </div>

            {# Sidebar - Vidéos recommandées #}
            <div class="col-12 col-lg-4">
                <div class="sidebar">
                    <div class="card">
                        <div class="card-header bg-light">
                            <h5 class="card-title mb-0">
                                <i class="bi bi-collection-play me-2"></i>{{ 'video.sidebar.related_videos'|trans }}
                            </h5>
                        </div>
                        <div class="card-body p-2">
                            {% for related_video in related_videos %}
                                <a href="{{ path('vgr_video_show', {id: related_video.id, slug: related_video.slug}) }}" 
                                   class="text-decoration-none text-reset">
                                    <div class="card mb-2 card-hover border-0 bg-light">
                                        <div class="row g-0">
                                            <div class="col-5">
                                                <div class="ratio ratio-16x9">
                                                    {% if related_video.thumbnail %}
                                                        <img src="{{ related_video.thumbnail }}" 
                                                             class="object-fit-cover rounded-start" 
                                                             alt="{{ related_video.title }}">
                                                    {% else %}
                                                        <div class="bg-secondary d-flex align-items-center justify-content-center rounded-start">
                                                            <i class="bi bi-play-circle text-white"></i>
                                                        </div>
                                                    {% endif %}
                                                </div>
                                            </div>
                                            <div class="col-7">
                                                <div class="card-body p-2">
                                                    <h6 class="card-title mb-1 small">{{ related_video.title|length > 60 ? related_video.title[:60] ~ '...' : related_video.title }}</h6>
                                                    <small class="text-muted d-block">
                                                        {% if related_video.player %}{{ related_video.player.pseudo }}{% endif %}
                                                    </small>
                                                    <small class="text-muted">
                                                        {{ related_video.viewCount }} views • {{ related_video.createdAt|date('M j') }}
                                                    </small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            {% else %}
                                <div class="text-center py-3">
                                    <i class="bi bi-camera-video text-muted fs-3"></i>
                                    <p class="text-muted mt-2 mb-0 small">{{ 'video.sidebar.no_related_videos'|trans }}</p>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <script>
        function toggleEditForm(commentId) {
            const content = document.querySelector('.comment-content-' + commentId);
            const editForm = document.querySelector('.edit-form-' + commentId);
            
            if (content && editForm) {
                content.classList.toggle('d-none');
                editForm.classList.toggle('d-none');
            }
        }
    </script>
{% endblock %}