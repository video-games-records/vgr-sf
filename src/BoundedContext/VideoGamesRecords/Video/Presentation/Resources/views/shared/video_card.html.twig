{% trans_default_domain 'VgrVideo' %}
<div class="col-12 col-sm-6 col-lg-4 col-xl-3">
    <div class="card h-100 video-card">
        <div class="position-relative">
            <div class="ratio ratio-16x9">
                {% if video.thumbnail %}
                    <img src="{{ video.thumbnail }}" 
                         class="object-fit-cover" 
                         alt="{{ video.title }}">
                {% else %}
                    <div class="bg-light d-flex align-items-center justify-content-center">
                        <i class="bi bi-play-circle fs-1 text-muted"></i>
                    </div>
                {% endif %}
            </div>
            
            {# Badge type vidéo #}
            <span class="position-absolute top-0 end-0 m-2 badge bg-{{ video.type == 'Youtube' ? 'danger' : 'primary' }}">
                {{ video.type }}
            </span>
            
            {# Vues #}
            <span class="position-absolute bottom-0 end-0 m-2 badge bg-dark">
                {{ video.viewCount }} {{ 'video.card.views'|trans }}
            </span>
        </div>
        
        <div class="card-body d-flex flex-column">
            <h6 class="card-title">{{ video.title|length > 50 ? video.title[:50] ~ '...' : video.title }}</h6>
            
            <div class="d-flex align-items-center mb-2">
                {% if video.player %}
                    <small class="text-muted">
                        <i class="bi bi-person-circle me-1"></i>
                        {{ video.player.pseudo }}
                    </small>
                {% endif %}
                {% if video.game %}
                    <small class="text-muted ms-auto">
                        <i class="bi bi-controller me-1"></i>
                        {{ video.game.getName(app.request.locale) }}
                    </small>
                {% endif %}
            </div>
            
            <div class="d-flex justify-content-between align-items-center mt-auto">
                <small class="text-muted">
                    <i class="bi bi-heart me-1"></i>{{ video.likeCount }}
                </small>
                <small class="text-muted">{{ video.createdAt|date('d/m/Y') }}</small>
            </div>
            
            <a href="{{ path('vgr_video_show', {id: video.id, slug: video.slug}) }}"
               class="btn btn-primary btn-sm mt-2">
                <i class="bi bi-play-fill me-1"></i>{{ 'video.card.watch'|trans }}
            </a>
        </div>
    </div>
</div>