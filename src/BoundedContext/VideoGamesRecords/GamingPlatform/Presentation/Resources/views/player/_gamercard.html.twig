{#
    Variables:
      - platform: PlatformEnum
      - profile: PlatformProfileData
#}
<div class="card mb-2">
    <div class="card-body p-2">
        {# Header : avatar + pseudo + statut #}
        <div class="d-flex align-items-center gap-2 mb-2">
            {% if profile.avatarUrl %}
                <img src="{{ profile.avatarUrl }}" alt="{{ profile.username }}"
                     width="48" height="48" class="rounded">
            {% endif %}
            <div>
                <a href="{{ platform.profileUrl(profile.externalId) }}"
                   target="_blank" rel="noopener noreferrer"
                   class="fw-bold text-decoration-none">
                    {{ profile.username }}
                    <i class="bi bi-box-arrow-up-right small ms-1"></i>
                </a>
                <div>
                    <span class="badge {% if profile.isOnline() %}bg-success{% else %}bg-secondary{% endif %} small">
                        {% if profile.isOnline() %}Online{% else %}Offline{% endif %}
                    </span>
                    <span class="text-muted small ms-1">{{ platform.label }}</span>
                </div>
            </div>
        </div>

        {# Derniers jeux #}
        {% if profile.recentGames is not empty %}
            <div class="border-top pt-2">
                <p class="text-muted small mb-1">{{ 'platform.profile.recent_games'|trans({}, 'VgrGamingPlatform') }}</p>
                <ul class="list-unstyled mb-0">
                    {% for game in profile.recentGames %}
                        <li class="d-flex align-items-center gap-2 mb-1">
                            {% if game.iconUrl %}
                                <img src="{{ game.iconUrl }}" alt="{{ game.name }}"
                                     width="24" height="24" class="rounded-1">
                            {% endif %}
                            <span class="small flex-grow-1 text-truncate" title="{{ game.name }}">{{ game.name }}</span>
                            <span class="text-muted small text-nowrap">
                                {{ game.playtimeForeverHours }}h
                                {% if game.playtime2WeeksMinutes > 0 %}
                                    <span class="text-success">(+{{ game.playtime2WeeksHours }}h)</span>
                                {% endif %}
                            </span>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}
    </div>
</div>
