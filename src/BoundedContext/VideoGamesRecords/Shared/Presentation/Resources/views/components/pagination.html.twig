{% if totalPages > 1 %}
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            <li class="page-item {{ currentPage == 1 ? 'disabled' : '' }}">
                <a class="page-link" href="{{ this.url(currentPage - 1) }}">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>

            {% set startPage = max(1, currentPage - 2) %}
            {% set endPage = min(totalPages, currentPage + 2) %}

            {% if startPage > 1 %}
                <li class="page-item">
                    <a class="page-link" href="{{ this.url(1) }}">1</a>
                </li>
                {% if startPage > 2 %}
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                {% endif %}
            {% endif %}

            {% for p in startPage..endPage %}
                <li class="page-item {{ p == currentPage ? 'active' : '' }}">
                    <a class="page-link" href="{{ this.url(p) }}">{{ p }}</a>
                </li>
            {% endfor %}

            {% if endPage < totalPages %}
                {% if endPage < totalPages - 1 %}
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                {% endif %}
                <li class="page-item">
                    <a class="page-link" href="{{ this.url(totalPages) }}">{{ totalPages }}</a>
                </li>
            {% endif %}

            <li class="page-item {{ currentPage == totalPages ? 'disabled' : '' }}">
                <a class="page-link" href="{{ this.url(currentPage + 1) }}">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
{% endif %}
