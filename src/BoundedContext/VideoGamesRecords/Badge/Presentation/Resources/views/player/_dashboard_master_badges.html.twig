{% trans_default_domain 'VgrCore' %}
{% if gained|length > 0 or lost|length > 0 %}
<div class="row g-2 mb-3">
    {% if gained|length > 0 %}
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header border-bottom">
                <h6 class="mb-0"><i class="bi bi-patch-check text-success"></i> {{ 'dashboard.badges.recently_gained'|trans({}, 'SharedKernel') }}</h6>
            </div>
            <div class="card-body p-2">
                <div class="d-flex flex-column gap-2">
                    {% for badge in gained %}
                    {% set gameName = app.request.locale == 'fr' ? badge.nameFr : badge.nameEn %}
                    <div class="d-flex align-items-center gap-2">
                        <img src="{{ badge_picture_url('badge/Master', badge.badgePicture) }}"
                             alt="{{ gameName }}"
                             width="32" height="32"
                             class="border rounded flex-shrink-0">
                        <div class="min-w-0">
                            <div class="small text-truncate">{{ gameName }}</div>
                            <div class="text-muted dashboard-game-thumb__date">{{ badge.createdAt|user_date('d/m/Y') }}</div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    {% if lost|length > 0 %}
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header border-bottom">
                <h6 class="mb-0"><i class="bi bi-patch-minus text-danger"></i> {{ 'dashboard.badges.recently_lost'|trans({}, 'SharedKernel') }}</h6>
            </div>
            <div class="card-body p-2">
                <div class="d-flex flex-column gap-2">
                    {% for badge in lost %}
                    {% set gameName = app.request.locale == 'fr' ? badge.nameFr : badge.nameEn %}
                    <div class="d-flex align-items-center gap-2">
                        <img src="{{ badge_picture_url('badge/Master', badge.badgePicture) }}"
                             alt="{{ gameName }}"
                             width="32" height="32"
                             class="border rounded flex-shrink-0 opacity-50">
                        <div class="min-w-0">
                            <div class="small text-truncate text-muted">{{ gameName }}</div>
                            <div class="text-muted dashboard-game-thumb__date">{{ badge.endedAt|user_date('d/m/Y') }}</div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
    {% endif %}
</div>
{% endif %}
