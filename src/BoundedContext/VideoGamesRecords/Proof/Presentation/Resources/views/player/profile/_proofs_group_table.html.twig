{% trans_default_domain 'VgrCore' %}

<div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
    {% for pc in playerCharts %}
        <div class="col">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center py-2">
                    <a href="{{ path('vgr_chart_show', {
                        id: pc.chart.group.game.id,
                        slug: pc.chart.group.game.slug,
                        groupId: pc.chart.group.id,
                        groupSlug: pc.chart.group.slug,
                        chartId: pc.chart.id,
                        chartSlug: pc.chart.slug
                    }) }}" class="fw-semibold text-truncate me-2 text-decoration-none">{{ pc.chart.name }}</a>
                    <span class="proof--{{ pc.status.cssClass }}" data-bs-toggle="tooltip" title="{{ pc.status.label }}"></span>
                </div>
                <div class="card-body p-2">
                    <div class="d-flex gap-3 small text-muted mb-2">
                        <span>{{ 'player.profile.proofs.column_score'|trans }}:
                            {% set scoreValues = [] %}
                            {% for lib in pc.libs %}
                                {% set scoreValues = scoreValues|merge([lib.value|format_score(lib.libChart.type.mask)]) %}
                            {% endfor %}
                            <strong class="text-body">{{ scoreValues|join(' / ') }}</strong>
                        </span>
                        <span>{{ 'player.profile.proofs.column_rank'|trans }}: <strong class="text-body">{{ pc.rank }}</strong></span>
                    </div>
                    {% if pc.proof %}
                        <twig:proof_display :proof="pc.proof" />
                    {% endif %}
                </div>
            </div>
        </div>
    {% endfor %}
</div>
