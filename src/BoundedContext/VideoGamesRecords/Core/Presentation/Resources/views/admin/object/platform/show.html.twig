{% extends '@SonataAdmin/CRUD/show.html.twig' %}
{% trans_default_domain 'VgrCoreAdmin' %}

{% block show_groups %}

    {# Header #}
    <div class="row">
        <div class="col-md-12">
            <div class="box box-primary">
                <div class="box-header with-border">
                    <h3 class="box-title">
                        <i class="fa fa-desktop"></i>
                        {{ object.getName() }}
                    </h3>
                    <div class="box-tools pull-right">
                        <span class="label label-info">ID: {{ object.getId() }}</span>
                        {% if object.getStatus() == 'ACTIF' %}
                            <span class="label label-success">{{ object.getStatus() }}</span>
                        {% else %}
                            <span class="label label-danger">{{ object.getStatus() }}</span>
                        {% endif %}
                    </div>
                </div>
                <div class="box-body">
                    <div class="row">
                        <div class="col-md-6">
                            <table class="table table-condensed">
                                <tr>
                                    <td><strong>{% trans %}platform.show.status{% endtrans %} :</strong></td>
                                    <td>
                                        {% if object.getStatus() == 'ACTIF' %}
                                            <span class="label label-success">{{ object.getStatus() }}</span>
                                        {% else %}
                                            <span class="label label-danger">{{ object.getStatus() }}</span>
                                        {% endif %}
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>{% trans %}platform.show.nbGame{% endtrans %} :</strong></td>
                                    <td><span class="badge badge-default">{{ object.getGames()|length }}</span></td>
                                </tr>
                            </table>
                        </div>
                        {% if object.getBadge() %}
                        <div class="col-md-6">
                            <div class="badge-block">
                                <a href="{{ path('vgrcorebundle_admin_badge_show', {'id': object.getBadge().getId()}) }}">
                                    <img src="{{ badge_picture_url(object.getBadge().type.directory, object.getBadge().picture) }}" alt="Badge" style="height: 48px;">
                                </a>
                                <span class="text-muted" style="margin-left: 10px;">
                                    {% trans %}badge.show.value{% endtrans %} : <strong>{{ object.getBadge().getValue() }}</strong>
                                    &nbsp;|&nbsp;
                                    {% trans %}badge.show.nbPlayer{% endtrans %} : <strong>{{ object.getBadge().getNbPlayer() }}</strong>
                                </span>
                            </div>
                        </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Games list #}
    {% set games = object.getGames() %}
    {% if games|length > 0 %}
    <div class="row">
        <div class="col-md-12">
            <div class="box box-default collapsed-box">
                <div class="box-header with-border">
                    <h3 class="box-title">
                        <i class="fa fa-gamepad"></i>
                        {% trans %}platform.show.games{% endtrans %}
                        <span class="badge badge-default">{{ games|length }}</span>
                    </h3>
                    <div class="box-tools pull-right">
                        <button type="button" class="btn btn-box-tool" data-widget="collapse">
                            <i class="fa fa-plus"></i>
                        </button>
                    </div>
                </div>
                <div class="box-body no-padding" style="display: none;">
                    <table class="table table-condensed table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>{% trans %}platform.show.game_name{% endtrans %}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for game in games %}
                            <tr>
                                <td>{{ game.getId() }}</td>
                                <td>{{ game.libGameEn }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    {# Badge History #}
    {% if object.getBadge() %}
        {% set playerHistory = vgr_player_badge_history(object.getBadge()) %}
        {% set teamHistory = vgr_team_badge_history(object.getBadge()) %}

        {% if playerHistory|length > 0 or teamHistory|length > 0 %}
        <div class="row">
            {% if playerHistory|length > 0 %}
            <div class="col-md-6">
                <div class="box box-primary">
                    <div class="box-header with-border">
                        <h3 class="box-title">
                            <i class="fa fa-user"></i>
                            {% trans %}game.show.badge_history.player_history{% endtrans %}
                            <span class="badge badge-default">{{ playerHistory|length }}</span>
                        </h3>
                    </div>
                    <div class="box-body no-padding">
                        <table class="table table-condensed table-striped">
                            <thead>
                                <tr>
                                    <th>{% trans %}game.show.badge_history.history.player{% endtrans %}</th>
                                    <th>{% trans %}game.show.badge_history.history.since{% endtrans %}</th>
                                    <th>{% trans %}game.show.badge_history.history.until{% endtrans %}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in playerHistory %}
                                <tr class="{{ row.endedAt is null ? 'success' : '' }}">
                                    <td>{{ row.pseudo }}</td>
                                    <td>{{ row.createdAt|date('d/m/Y') }}</td>
                                    <td>
                                        {% if row.endedAt is null %}
                                            <span class="label label-success">{% trans %}game.show.badge_history.history.active{% endtrans %}</span>
                                        {% else %}
                                            {{ row.endedAt|date('d/m/Y') }}
                                        {% endif %}
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            {% endif %}

            {% if teamHistory|length > 0 %}
            <div class="col-md-6">
                <div class="box box-warning">
                    <div class="box-header with-border">
                        <h3 class="box-title">
                            <i class="fa fa-users"></i>
                            {% trans %}game.show.badge_history.team_history{% endtrans %}
                            <span class="badge badge-default">{{ teamHistory|length }}</span>
                        </h3>
                    </div>
                    <div class="box-body no-padding">
                        <table class="table table-condensed table-striped">
                            <thead>
                                <tr>
                                    <th>{% trans %}game.show.badge_history.history.team{% endtrans %}</th>
                                    <th>{% trans %}game.show.badge_history.history.since{% endtrans %}</th>
                                    <th>{% trans %}game.show.badge_history.history.until{% endtrans %}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in teamHistory %}
                                <tr class="{{ row.endedAt is null ? 'success' : '' }}">
                                    <td>{{ row.libTeam }}</td>
                                    <td>{{ row.createdAt|date('d/m/Y') }}</td>
                                    <td>
                                        {% if row.endedAt is null %}
                                            <span class="label label-success">{% trans %}game.show.badge_history.history.active{% endtrans %}</span>
                                        {% else %}
                                            {{ row.endedAt|date('d/m/Y') }}
                                        {% endif %}
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            {% endif %}
        </div>
        {% endif %}
    {% endif %}

{% endblock %}
