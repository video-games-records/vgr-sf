{% extends '@SonataAdmin/CRUD/base_list_field.html.twig' %}

{% block field %}
    {% set badge = object.badge %}
    {% if badge %}
        {% set badge_admin = admin.configurationPool.getAdminByAdminCode('sonata.admin.vgr.badge') %}
        {% if badge_admin.hasAccess('edit', badge) %}
            <div class="vgr-picture-dropzone"
                 data-vgr-picture-dropzone
                 data-upload-url="{{ badge_admin.generateObjectUrl('upload-picture-ajax', badge) }}"
                 data-csrf-token="{{ csrf_token('badge_upload_picture_ajax') }}"
                 data-success-message="{{ 'badge.list.picture_upload_success'|trans({}, 'VgrCoreAdmin') }}"
            >
                <span class="vgr-picture-dropzone__filename">{{ badge.picture ?: '—' }}</span>
                <div class="vgr-picture-dropzone__zone">
                    <i class="fa fa-upload"></i>
                    <span class="vgr-picture-dropzone__hint">{{ 'badge.list.picture_drop_hint'|trans({}, 'VgrCoreAdmin') }}</span>
                </div>
                <input type="file" class="vgr-picture-dropzone__input" accept="image/png,image/jpeg,image/gif" hidden>
                <span class="vgr-picture-dropzone__message"></span>
            </div>
        {% else %}
            {{ badge.picture }}
        {% endif %}
    {% else %}
        —
    {% endif %}
{% endblock %}
