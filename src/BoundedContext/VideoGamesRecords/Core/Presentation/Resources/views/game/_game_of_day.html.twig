<div class="card border shadow-sm h-100">
    <div class="card-header border-bottom">
        <h5 class="mb-0"><i class="bi bi-trophy"></i> {{ 'game.game_of_day.title'|trans({}, 'VgrCore') }}</h5>
    </div>
    {% if game %}
        <a href="{{ path('vgr_game_show', {id: game.id, slug: game.slug}) }}" class="card-body p-0 text-decoration-none text-body">
            <div class="text-center p-2">
                <img src="{{ game_picture_url(game.picture) }}" alt="{{ game.name }}" class="img-fluid" style="max-height: 180px;">
            </div>
            <div class="p-3 pt-0">
                <h6 class="mb-2 text-center">{{ game.name }}</h6>
                {% if game.platforms|length > 0 %}
                    <div class="text-center">
                        <small class="text-muted d-block mb-1">{{ 'game.platforms'|trans({}, 'VgrCore') }}</small>
                        <div class="d-flex flex-wrap justify-content-center gap-1">
                            {% for platform in game.platforms %}
                                <span class="badge bg-secondary text-white small">{{ platform.name }}</span>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            </div>
        </a>
    {% else %}
        <div class="card-body text-center text-muted py-4">
            {{ 'game.game_of_day.no_game'|trans({}, 'VgrCore') }}
        </div>
    {% endif %}
</div>
