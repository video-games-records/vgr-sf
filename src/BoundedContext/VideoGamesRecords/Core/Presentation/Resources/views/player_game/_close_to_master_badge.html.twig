{% trans_default_domain 'VgrCore' %}
<div class="card mb-3">
    <div class="card-header border-bottom">
        <h6 class="mb-0"><i class="bi bi-trophy-fill text-gold"></i> {{ 'player_game.close_to_master_badge.card_title'|trans }}</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
                <tbody>
                    {% for row in rows %}
                    {% set gap = row.leaderPoints > 0 ? row.leaderPoints - row.playerGame.pointChart : 0 %}
                    {% set gapPercent = row.leaderPoints > 0 ? ((gap / row.leaderPoints) * 100)|round(1) : 0 %}
                    <tr>
                        <td>
                            <a href="{{ path('vgr_game_show', {id: row.playerGame.game.id, slug: row.playerGame.game.slug}) }}" class="text-decoration-none fw-semibold">
                                {{ row.playerGame.game.name }}
                            </a>
                        </td>
                        <td class="text-center text-nowrap">
                            <span class="badge bg-secondary">#2</span>
                        </td>
                        <td class="text-center text-nowrap small">
                            {{ row.playerGame.pointChart|number_format }}
                        </td>
                        <td class="text-center text-nowrap small text-muted">
                            {{ row.leaderPoints|number_format }}
                        </td>
                        <td class="text-end text-nowrap">
                            {% if gapPercent <= 2 %}
                                <span class="badge text-bg-success">-{{ gapPercent }}%</span>
                            {% elseif gapPercent <= 5 %}
                                <span class="badge text-bg-warning">-{{ gapPercent }}%</span>
                            {% else %}
                                <span class="badge text-bg-secondary">-{{ gapPercent }}%</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
