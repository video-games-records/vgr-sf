{% extends '@SharedKernel/base.html.twig' %}
{% trans_default_domain 'VgrCore' %}

{% block title %}{{ 'player.index.title'|trans }}{% endblock %}

{% block meta_description %}{{ 'player.index.meta_description'|trans }}{% endblock %}

{% block body %}
<div class="container py-4">
    {# Breadcrumb Navigation #}
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="{{ path('home') }}">
                    <i class="bi bi-house"></i> {{ 'breadcrumb.home'|trans }}
                </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                {{ 'player.index.breadcrumb'|trans }}
            </li>
        </ol>
    </nav>

    {# Page Header #}
    <div class="mb-4">
        <h1 class="h3">
            <i class="bi bi-people"></i>
            {{ 'player.index.header'|trans }}
        </h1>
        <p class="text-muted">{{ 'player.index.description'|trans({'%count%': totalPlayers}) }}</p>
    </div>

    <div class="row">
        {# Filters : static sidebar at lg+, slide-in drawer below lg (single markup, Bootstrap's responsive offcanvas) #}
        <div class="col-lg-3 mb-4">
            <div class="offcanvas-lg offcanvas-start card shadow-sm" tabindex="-1" id="playerFiltersOffcanvas" aria-labelledby="playerFiltersLabel">
                <div class="offcanvas-header card-header">
                    <h2 class="offcanvas-title h6 mb-0" id="playerFiltersLabel">
                        <i class="bi bi-funnel"></i> {{ 'player.index.filter.title'|trans }}
                    </h2>
                    <button type="button" class="btn-close d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#playerFiltersOffcanvas" aria-label="{{ 'common.close'|trans({}, 'SharedKernel') }}"></button>
                </div>
                <div class="offcanvas-body card-body">
                    {% include '@VideoGamesRecordsCore/player/_filter_form.html.twig' %}
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            {# Mobile filter trigger #}
            <div class="d-lg-none mb-3">
                <button class="btn btn-outline-secondary w-100" type="button" data-bs-toggle="offcanvas" data-bs-target="#playerFiltersOffcanvas" aria-controls="playerFiltersOffcanvas">
                    <i class="bi bi-funnel"></i> {{ 'player.index.filter.title'|trans }}
                    {% if activeFilterCount > 0 %}
                        <span class="badge bg-primary ms-1">{{ activeFilterCount }}</span>
                    {% endif %}
                </button>
            </div>

            {% if hasActiveFilters %}
                {% include '@VideoGamesRecordsCore/player/_active_filters.html.twig' %}
            {% endif %}

            {# Players Table #}
            {% if players|length > 0 %}
                <div class="card shadow-sm">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th class="text-center d-none d-md-table-cell" style="width: 50px;">#</th>
                                    <th class="d-none d-md-table-cell" style="width: 60px;"></th>
                                    <th>
                                        {{ _self.sort_header('pseudo', 'player.index.column_pseudo'|trans, currentSort, currentOrder) }}
                                    </th>
                                    <th class="d-none d-sm-table-cell">
                                        {{ 'player.index.column_platforms'|trans }}
                                    </th>
                                    <th class="text-end">
                                        {{ _self.sort_header('pointGame', 'player.index.column_points'|trans, currentSort, currentOrder) }}
                                    </th>
                                    <th class="text-center d-none d-lg-table-cell">
                                        {{ _self.sort_header('nbGame', 'player.index.column_games'|trans, currentSort, currentOrder) }}
                                    </th>
                                    <th class="text-center d-none d-lg-table-cell">
                                        {{ _self.sort_header('nbChart', 'player.index.column_charts'|trans, currentSort, currentOrder) }}
                                    </th>
                                    <th class="text-center d-none d-md-table-cell">
                                        {{ _self.sort_header('createdAt', 'player.index.column_registered'|trans, currentSort, currentOrder) }}
                                    </th>
                                    <th class="text-center d-none d-xl-table-cell">
                                        {{ _self.sort_header('lastLogin', 'player.index.column_last_login'|trans, currentSort, currentOrder) }}
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for player in players %}
                                    <tr {% if app.user and player.getUserId() == app.user.id %}class="table-primary"{% endif %}>
                                        <td class="text-center align-middle d-none d-md-table-cell text-muted">
                                            {{ (currentPage - 1) * limit + loop.index }}
                                        </td>
                                        <td class="align-middle d-none d-md-table-cell">
                                            <img src="{{ player_avatar_url(player.avatar) }}"
                                                 alt="{{ player.pseudo }}"
                                                 class="rounded-circle"
                                                 width="40"
                                                 height="40">
                                        </td>
                                        <td class="align-middle">
                                            {{ component('player_link', {
                                                player: player,
                                                bold: false,
                                                showTeam: true,
                                                showCountry: true,
                                                showAvatar: false
                                            }) }}
                                        </td>
                                        <td class="align-middle d-none d-sm-table-cell">
                                            <div class="d-flex flex-wrap gap-1">
                                                {% for connection in connectionsByPlayer[player.id] ?? [] %}
                                                    {{ component('platform_connection_badge', {connection: connection}) }}
                                                {% endfor %}
                                            </div>
                                        </td>
                                        <td class="text-end align-middle">
                                            <strong>{{ player.pointGame|number_format(0, '.', ',') }}</strong>
                                        </td>
                                        <td class="text-center align-middle d-none d-lg-table-cell">
                                            {{ player.nbGame }}
                                        </td>
                                        <td class="text-center align-middle d-none d-lg-table-cell">
                                            {{ player.nbChart }}
                                        </td>
                                        <td class="text-center align-middle d-none d-md-table-cell">
                                            {% if player.createdAt %}
                                                {{ player.createdAt|user_date('d/m/Y') }}
                                            {% else %}
                                                -
                                            {% endif %}
                                        </td>
                                        <td class="text-center align-middle d-none d-xl-table-cell">
                                            {% if player.lastLogin %}
                                                {{ player.lastLogin|user_date('d/m/Y') }}
                                            {% else %}
                                                -
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="mt-4">
                    {{ component('pagination', {
                        currentPage: currentPage,
                        totalPages: totalPages,
                        route: 'vgr_player_index',
                        routeParams: app.request.query.all|merge({sort: currentSort, order: currentOrder}),
                    }) }}
                </div>

                {# Results Count #}
                <div class="mt-3 text-center text-muted small">
                    {{ 'player.index.showing_results'|trans({'%start%': ((currentPage - 1) * limit) + 1, '%end%': min(currentPage * limit, totalPlayers), '%total%': totalPlayers}) }}
                </div>
            {% else %}
                {# No Players Found #}
                <div class="card shadow-sm">
                    <div class="card-body text-center text-muted py-5">
                        <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                        <p class="mt-3 mb-0">{{ 'player.index.no_players'|trans }}</p>
                        {% if hasActiveFilters %}
                            <p class="small mb-0">{{ 'player.index.no_players_hint'|trans }}</p>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>

{# Macro for sortable column headers #}
{% macro sort_header(field, label, currentSort, currentOrder) %}
    {% set newOrder = (currentSort == field and currentOrder == 'ASC') ? 'DESC' : 'ASC' %}
    {% set isActive = currentSort == field %}
    <a href="{{ path('vgr_player_index', app.request.query.all|merge({sort: field, order: newOrder, page: 1})) }}"
       class="text-decoration-none {{ isActive ? 'fw-bold' : '' }}">
        {{ label }}
        {% if isActive %}
            <i class="bi bi-caret-{{ currentOrder == 'ASC' ? 'up' : 'down' }}-fill"></i>
        {% endif %}
    </a>
{% endmacro %}
{% endblock %}
