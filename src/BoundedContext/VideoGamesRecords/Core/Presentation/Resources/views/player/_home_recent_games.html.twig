{% trans_default_domain 'VgrCore' %}
<div class="card mb-3">
    <div class="card-header border-bottom">
        <h6 class="mb-0"><i class="bi bi-clock-history"></i> {{ 'player.home_recent_games.card_title'|trans }}</h6>
    </div>
    <div class="card-body">
        {% if playerGames|length > 0 %}
        <div class="d-flex flex-wrap gap-2">
            {% for playerGame in playerGames %}
            <a href="{{ path('vgr_game_show', {id: playerGame.game.id, slug: playerGame.game.slug}) }}"
               class="text-decoration-none text-center dashboard-game-thumb">
                {% if playerGame.game.picture %}
                <img src="{{ game_picture_url(playerGame.game.picture) }}"
                     alt="{{ playerGame.game.name }}"
                     class="img-thumbnail d-block mb-1">
                {% else %}
                <div class="img-thumbnail d-flex align-items-center justify-content-center mb-1">
                    <i class="bi bi-controller text-secondary fs-4"></i>
                </div>
                {% endif %}
                <div class="text-truncate dashboard-game-thumb__name">{{ playerGame.game.name }}</div>
                <div class="text-muted dashboard-game-thumb__date">{{ playerGame.lastUpdate|user_date('d/m/Y') }}</div>
            </a>
            {% endfor %}
        </div>
        {% else %}
        <p class="text-muted small mb-0">{{ 'player.home_recent_games.no_games'|trans }}</p>
        {% endif %}
    </div>
</div>
