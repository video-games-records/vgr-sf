<div class="card border shadow-sm">
    <div class="card-header border-bottom">
        <h5 class="mb-0"><i class="bi bi-clock-history"></i> {{ 'player.home_recent_games.card_title'|trans({}, 'VgrCore') }}</h5>
    </div>
    <div class="card-body p-0">
        <div class="list-group list-group-flush">
            {% for playerGame in playerGames %}
                <a href="{{ path('vgr_game_show', {id: playerGame.game.id, slug: playerGame.game.slug}) }}" class="list-group-item list-group-item-action">
                    <div class="d-flex w-100 justify-content-between align-items-center">
                        <span class="text-truncate me-2">{{ playerGame.game.name }}</span>
                        <small class="text-muted text-nowrap">{{ playerGame.lastUpdate|date('M d') }}</small>
                    </div>
                </a>
            {% else %}
                <div class="list-group-item text-center text-muted py-4">
                    {{ 'player.home_recent_games.no_games'|trans({}, 'VgrCore') }}
                </div>
            {% endfor %}
        </div>
    </div>
</div>
