{% trans_default_domain 'VgrCore' %}
<div class="card border shadow-sm">
    <div class="card-header border-bottom">
        <h5 class="mb-0"><i class="bi bi-controller"></i> {{ 'player.recent_games.title'|trans }}</h5>
    </div>
    {% if not isLoggedIn %}
        <div class="card-body text-center py-4">
            <p class="text-muted mb-3">{{ 'player.recent_games.login_required'|trans }}</p>
            <a href="{{ path('app_login', {_locale: app.request.locale}) }}" class="btn btn-primary btn-sm">
                <i class="bi bi-person-lock"></i> {{ 'player.recent_games.login'|trans }}
            </a>
        </div>
    {% elseif playerGames is empty %}
        <div class="card-body text-center text-muted py-4">
            {{ 'player.recent_games.empty'|trans }}
        </div>
    {% else %}
        <ul class="list-group list-group-flush">
            {% for playerGame in playerGames %}
                <li class="list-group-item px-3 py-2">
                    <a href="{{ path('vgr_game_show', {id: playerGame.game.id, slug: playerGame.game.slug}) }}"
                       class="d-flex align-items-center gap-3 text-decoration-none text-body">
                        <img src="{{ game_picture_url(playerGame.game.picture) }}"
                             alt="{{ playerGame.game.name }}"
                             class="rounded"
                             style="width: 48px; height: 48px; object-fit: cover;">
                        <div class="flex-grow-1 overflow-hidden">
                            <div class="fw-semibold text-truncate">{{ playerGame.game.name }}</div>
                            <small class="text-muted">{{ playerGame.lastUpdate|date('d/m/Y') }}</small>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</div>
