{% trans_default_domain 'VgrTeam' %}
{{ form_start(filterForm, {'attr': {'class': 'team-filter-form'}}) }}
{{ form_widget(filterForm.sort) }}
{{ form_widget(filterForm.order) }}

<div class="mb-3">
    {{ form_label(filterForm.q) }}
    {{ form_widget(filterForm.q) }}
</div>

<div class="mb-3">
    {{ form_label(filterForm.status) }}
    {{ form_widget(filterForm.status) }}
</div>

<div class="mb-3">
    {{ form_label(filterForm.minPlayers) }}
    {{ form_widget(filterForm.minPlayers) }}
</div>

<div class="mb-3">
    <label class="form-label">{{ 'team.index.filter.points'|trans }}</label>
    <div class="d-flex gap-2">
        {{ form_widget(filterForm.pointsMin, {'attr': {'placeholder': 'team.index.filter.points_min'|trans}}) }}
        {{ form_widget(filterForm.pointsMax, {'attr': {'placeholder': 'team.index.filter.points_max'|trans}}) }}
    </div>
</div>

<div class="form-check mb-3">
    {{ form_widget(filterForm.hasBadges, {'attr': {'class': 'form-check-input'}}) }}
    {{ form_label(filterForm.hasBadges, null, {'label_attr': {'class': 'form-check-label'}}) }}
</div>

<div class="d-grid gap-2">
    <button type="submit" class="btn btn-primary">
        <i class="bi bi-funnel"></i> {{ 'team.index.filter.apply'|trans }}
    </button>
    {% if hasActiveFilters %}
        <a href="{{ path('vgr_team_index', {sort: currentSort, order: currentOrder}) }}" class="btn btn-outline-secondary">
            {{ 'team.index.filter.reset'|trans }}
        </a>
    {% endif %}
</div>
{{ form_end(filterForm) }}
