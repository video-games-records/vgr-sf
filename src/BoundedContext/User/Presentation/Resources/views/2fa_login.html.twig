{% extends '@SharedKernel/base.html.twig' %}
{% trans_default_domain 'User' %}

{% block title %}
    {{ 'two_factor.title'|trans }} - Video Games Records
{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <i class="bi bi-shield-lock fs-1 text-primary"></i>
                        <h1 class="card-title mt-2">{{ 'two_factor.title'|trans }}</h1>
                        <p class="text-muted">{{ 'two_factor.subtitle'|trans }}</p>
                    </div>

                    {% if authenticationError %}
                        <div class="alert alert-danger" role="alert">
                            {{ authenticationError|trans(authenticationErrorData, 'SchebTwoFactorBundle') }}
                        </div>
                    {% endif %}

                    <form method="post" action="{{ checkPathUrl ? checkPathUrl : path(checkPathRoute) }}" data-turbo="false">
                        <div class="mb-3">
                            <label for="auth_code" class="form-label fw-semibold">
                                {{ 'two_factor.form.code.label'|trans }}
                            </label>
                            <input
                                type="text"
                                class="form-control form-control-lg text-center"
                                id="auth_code"
                                name="{{ authCodeParameterName }}"
                                inputmode="numeric"
                                pattern="[0-9]{6}"
                                maxlength="6"
                                placeholder="000000"
                                required
                                autofocus
                                autocomplete="one-time-code"
                            >
                            <div class="form-text text-center">{{ 'two_factor.form.code.help'|trans }}</div>
                        </div>

                        {% if isCsrfProtectionEnabled %}
                            <input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">
                        {% endif %}

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary btn-lg">
                                {{ 'two_factor.form.submit'|trans }}
                            </button>
                        </div>

                        <div class="text-center">
                            <a href="{{ logoutPath }}" class="text-muted text-decoration-none">
                                <i class="bi bi-arrow-left"></i> {{ 'two_factor.form.cancel'|trans }}
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
