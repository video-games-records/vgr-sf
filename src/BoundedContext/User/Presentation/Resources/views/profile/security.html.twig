{% extends '@SharedKernel/base.html.twig' %}
{% trans_default_domain 'User' %}

{% block title %}{{ 'profile.security.title'|trans }} - {{ 'profile.title.main'|trans }} - {{ parent() }}{% endblock %}

{% block body %}
<div class="container py-4">
<div class="profile-settings">
    <div class="mb-4">
        <h1>{{ 'profile.title.main'|trans }}</h1>
        <p class="text-muted">{{ 'profile.title.subtitle'|trans }}</p>
    </div>

    {% for label, messages in app.flashes() %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {% if label == 'success' %}<i class="bi bi-check-circle"></i>{% endif %}
                {% if label == 'danger' %}<i class="bi bi-exclamation-triangle"></i>{% endif %}
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{{ 'common.close'|trans }}"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="card shadow-sm">
        <div class="card-body">
            {% include '@User/profile/_navigation.html.twig' %}

            <div class="mt-4">
                <h3 class="mb-1">{{ 'profile.security.title'|trans }}</h3>
                <p class="text-muted mb-4">{{ 'profile.security.description'|trans }}</p>

                {# --- État actuel 2FA --- #}
                <div class="card mb-4">
                    <div class="card-body d-flex align-items-center gap-3">
                        {% if totp_enabled %}
                            <i class="bi bi-shield-fill-check fs-2 text-success"></i>
                            <div class="flex-grow-1">
                                <h5 class="mb-1">{{ 'profile.security.totp.status.enabled'|trans }}</h5>
                                <p class="text-muted mb-0">{{ 'profile.security.totp.status.enabled_desc'|trans }}</p>
                            </div>
                            <span class="badge bg-success">{{ 'profile.security.totp.badge.active'|trans }}</span>
                        {% else %}
                            <i class="bi bi-shield fs-2 text-secondary"></i>
                            <div class="flex-grow-1">
                                <h5 class="mb-1">{{ 'profile.security.totp.status.disabled'|trans }}</h5>
                                <p class="text-muted mb-0">{{ 'profile.security.totp.status.disabled_desc'|trans }}</p>
                            </div>
                            <span class="badge bg-secondary">{{ 'profile.security.totp.badge.inactive'|trans }}</span>
                        {% endif %}
                    </div>
                </div>

                {# --- Étape 1 : Lancer l'activation --- #}
                {% if not totp_enabled and not totp_pending %}
                    <form method="post" action="{{ path('app_profile_security_enable') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('totp_enable') }}">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-shield-plus"></i> {{ 'profile.security.totp.action.enable'|trans }}
                        </button>
                    </form>
                {% endif %}

                {# --- Étape 2 : Scanner le QR code et confirmer --- #}
                {% if totp_pending and qr_content %}
                    <div class="alert alert-info mb-3">
                        <i class="bi bi-info-circle"></i> {{ 'profile.security.totp.setup.instructions'|trans }}
                    </div>

                    <div class="text-center mb-4">
                        <div class="d-inline-block p-3 bg-white border rounded"
                             data-controller="totp-qrcode"
                             data-totp-qrcode-content-value="{{ qr_content }}"></div>
                    </div>

                    <form method="post" action="{{ path('app_profile_security_confirm') }}" class="mb-4">
                        <input type="hidden" name="_token" value="{{ csrf_token('totp_confirm') }}">
                        <div class="row justify-content-center">
                            <div class="col-md-6">
                                <label for="totp_code" class="form-label fw-semibold">
                                    {{ 'profile.security.totp.setup.code_label'|trans }}
                                </label>
                                <div class="input-group">
                                    <input
                                        type="text"
                                        class="form-control text-center"
                                        id="totp_code"
                                        name="totp_code"
                                        inputmode="numeric"
                                        pattern="[0-9]{6}"
                                        maxlength="6"
                                        placeholder="000000"
                                        required
                                        autocomplete="one-time-code"
                                    >
                                    <button type="submit" class="btn btn-success">
                                        <i class="bi bi-check-lg"></i> {{ 'profile.security.totp.setup.confirm'|trans }}
                                    </button>
                                </div>
                                <div class="form-text">{{ 'profile.security.totp.setup.code_help'|trans }}</div>
                            </div>
                        </div>
                    </form>
                {% endif %}

                {# --- Désactivation --- #}
                {% if totp_enabled %}
                    <hr class="my-4">
                    <h5>{{ 'profile.security.totp.disable.title'|trans }}</h5>
                    <p class="text-muted">{{ 'profile.security.totp.disable.description'|trans }}</p>
                    <form method="post" action="{{ path('app_profile_security_disable') }}" class="row g-2 align-items-end">
                        <input type="hidden" name="_token" value="{{ csrf_token('totp_disable') }}">
                        <div class="col-md-5">
                            <label for="current_password" class="form-label">
                                {{ 'profile.security.totp.disable.password_label'|trans }}
                            </label>
                            <input type="password" class="form-control" id="current_password" name="current_password" required>
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-danger" onclick="return confirm('{{ 'profile.security.totp.disable.confirm'|trans|e('html_attr') }}')">
                                <i class="bi bi-shield-x"></i> {{ 'profile.security.totp.action.disable'|trans }}
                            </button>
                        </div>
                    </form>
                {% endif %}
            </div>
        </div>
    </div>
</div>
</div>
{% endblock %}

