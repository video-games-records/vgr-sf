{% extends '@SharedKernel/base.html.twig' %}
{% trans_default_domain 'User' %}

{% block title %}{{ 'profile.parameters.title'|trans }} - {{ 'profile.title.main'|trans }} - {{ parent() }}{% endblock %}

{% block body %}
<div class="container py-4">
<div class="profile-settings">
    <div class="mb-4">
        <h1>{{ 'profile.title.main'|trans }}</h1>
        <p class="text-muted">{{ 'profile.title.subtitle'|trans }}</p>
    </div>

    {% for label, messages in app.flashes() %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {% if label == 'success' %}<i class="bi bi-check-circle"></i>{% endif %}
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{{ 'common.close'|trans }}"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="card shadow-sm">
        <div class="card-body">
            {% include '@User/profile/_navigation.html.twig' %}

            <div class="mt-4">
                <h3 class="mb-4">{{ 'profile.parameters.title'|trans }}</h3>
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> {{ 'profile.parameters.description'|trans }}
                </div>

                {{ form_start(form) }}
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_label(form.home_dashboard) }}
                            {{ form_widget(form.home_dashboard) }}
                            <div class="form-text text-muted">{{ 'profile.parameters.form.home_dashboard.help'|trans }}</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            {{ form_row(form.score_form_per_page) }}
                            <div class="form-text text-muted">{{ 'profile.parameters.form.score_form_per_page.help'|trans }}</div>
                        </div>
                    </div>
                    <div class="mt-3">
                        {{ form_widget(form.submit) }}
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
</div>
{% endblock %}
